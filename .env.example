# Supabase — server-side only (RLS is deny-all; no public/browser access)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Direct Postgres connection, used only by migrations/seed scripts
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# OpenRouter — guide generation + chat assistant (server-side only)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: overrides the guide generation model.
# Default: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_GUIDE_MODEL=
# Optional: overrides the chat assistant model. Chat needs a fast, non-reasoning
# model (the guest watches it type), so it does not share the guide model.
# Default: nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_CHAT_MODEL=
